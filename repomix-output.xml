@import "@fontsource/ibm-plex-mono/500.css";

/*
 * =========================================================================
 * TOKENS DE DESIGN — "Livro-Razão" (Ledger)
 * =========================================================================
 * Paleta de tinta escura inspirada em extratos bancários e livros-razão
 * contabilísticos: fundo quase-preto, réguas finas em vez de sombras,
 * números tabulares em mono, e um único acento dourado ("património")
 * que se distingue do verde (ganho) e vermelho (perda).
 */
:root {
  --color-ink:          #0B0F14;
  --color-surface:      #12171F;
  --color-surface-alt:  #1A212B;
  --color-line:         #232B36;
  --color-line-soft:    #1A212B;
  --color-text:         #EDEFF2;
  --color-text-muted:   #8A93A3;
  --color-text-faint:   #57616F;
  --color-gold:         #D9A441;
  --color-gold-soft:    #3A2F1B;
  --color-gain:         #35D28A;
  --color-gain-soft:    #123023;
  --color-loss:         #E5636A;
  --color-loss-soft:    #331A1D;
  --color-info:         #6C9BD1;

  --font-display: "Fraunces", ui-serif, Georgia, serif;
  --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
}

@theme inline {
  --color-ink: var(--color-ink);
  --color-surface: var(--color-surface);
  --color-surface-alt: var(--color-surface-alt);
  --color-line: var(--color-line);
  --color-text: var(--color-text);
  --color-text-muted: var(--color-text-muted);
  --color-text-faint: var(--color-text-faint);
  --color-gold: var(--color-gold);
  --color-gold-soft: var(--color-gold-soft);
  --color-gain: var(--color-gain);
  --color-gain-soft: var(--color-gain-soft);
  --color-loss: var(--color-loss);
