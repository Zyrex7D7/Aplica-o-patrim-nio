        <div className="mt-5">
          <p className="text-sm text-text-muted">Hoje</p>
          {hasQuotes ? (
            <p className={cx("tabular text-xl sm:text-2xl mt-0.5", tone(dayChangeEur))}>
              {formatPercent(dayChangePct)}
              <span className="text-text-faint mx-2">·</span>
