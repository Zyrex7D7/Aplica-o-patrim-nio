                    {formatCurrency(totalReturn)} <span className="opacity-70">({formatPercent(totalReturnPct)})</span>
                  </p>
                </div>
              </div>

              <div className="flex items-center justify-between mt-3 pt-2 border-t border-line-soft text-[11px] text-text-faint">
