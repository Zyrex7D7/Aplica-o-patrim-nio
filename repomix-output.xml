            className="mt-3 rounded-md bg-gold px-3 py-2.5 text-sm font-medium text-ink hover:opacity-90 disabled:opacity-50"
          >
            {loading ? "A entrar..." : "Entrar"}
          </button>
        </form>

        <p className="text-xs text-text-faint mt-6 leading-relaxed">
